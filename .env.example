# Compose uses this file for non-secret deployment selectors. Jira credentials belong only in data/secrets/jira-token (mode 0600), never here.
# Startup still rejects JIRA_TOKEN and OPENAI_API_KEY in this file/environment.
# OpenClaw image version. Upgrade deliberately after reviewing release notes.
OPENCLAW_VERSION=2026.7.1-2
# Optional host loopback port for the Gateway UI/API.
OPENCLAW_GATEWAY_PORT=18789
# Host path for the local encryption key used by OAuth-backed auth profiles.
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./data/auth-profile-secrets
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Dedicated Telegram bot.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Numeric controlled operator for smoke plus remaining directive/owner authorization.
# Public /request_access is not restricted to this ID.
TELEGRAM_PILOT_SENDER_ID=123456789

# Reviewed canonical model route available to the configured OpenAI auth profile.
OPENAI_MODEL=openai/<reviewed-model-id>

# Fixed Jira Server HTTPS origin. Project/type/JQL/read fields are deployment config, while runtime IDs are discovered.
# Without data/secrets/jira-token, Draft remains available and Jira search/create stay unavailable.
JIRA_BASE_URL=https://jira.invalid

# Comma-separated numeric Telegram sender IDs for server-side route allowlists.
# The controlled operator must be present so it can perform Business Admin smoke actions.
BUSINESS_ADMIN_TELEGRAM_IDS=123456789
PRODUCT_OWNER_TELEGRAM_IDS=987654321
