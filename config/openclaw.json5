{
  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      skipBootstrap: true,
      model: {
        primary: "${OPENAI_MODEL}",
      },
    },
    list: [
      {
        id: "idea-mvp",
        default: true,
        name: "Idea-to-Jira MVP",
        workspace: "/home/node/.openclaw/workspace",
        tools: {
          allow: [
            "idea_to_jira_create_draft",
            "idea_to_jira_read_draft",
            "idea_to_jira_patch_draft",
            "idea_to_jira_cancel_draft",
            "idea_to_jira_request_access",
          ],
        },
      },
    ],
  },
  tools: {
    media: {
      audio: { enabled: false },
    },
  },
  session: {
    dmScope: "per-account-channel-peer",
  },
  bindings: [
    {
      agentId: "idea-mvp",
      match: {
        channel: "telegram",
        accountId: "idea-mvp",
      },
    },
  ],
  channels: {
    telegram: {
      enabled: true,
      defaultAccount: "idea-mvp",
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_PILOT_SENDER_ID}"],
      groupPolicy: "disabled",
      accounts: {
        "idea-mvp": {
          enabled: true,
          botToken: "${TELEGRAM_BOT_TOKEN}",
          dmPolicy: "allowlist",
          allowFrom: ["${TELEGRAM_PILOT_SENDER_ID}"],
          groupPolicy: "disabled",
        },
      },
    },
  },
  plugins: {
    allow: ["idea-to-jira"],
    load: {
      paths: ["${IDEA_TO_JIRA_PLUGIN_PATH}"],
    },
    entries: {
      "idea-to-jira": {
        enabled: true,
        hooks: {
          // Required by OpenClaw 2026.7.1-2 for the typed before_agent_run gate.
          allowConversationAccess: true,
        },
        config: {
          agentId: "idea-mvp",
          telegram: {
            channelId: "telegram",
            accountId: "idea-mvp",
            pilotSenderIdEnv: "TELEGRAM_PILOT_SENDER_ID",
            adminSenderIdsEnv: "BUSINESS_ADMIN_TELEGRAM_IDS",
          },
          notifications: {
            productOwnerSenderIdsEnv: "PRODUCT_OWNER_TELEGRAM_IDS",
          },
          jira: {
            originEnv: "JIRA_BASE_URL",
            tokenEnv: "JIRA_TOKEN",
            projectKey: "FPF",
            projectId: "18100",
            issueTypeName: "Feature",
            issueTypeId: "11500",
            writeMode: "disabled",
          },
          catalog: {
            path: "/home/node/.openclaw/workspace/knowledge/catalog.md",
            schemaVersion: 1,
            sha256: "59fae2568168a4859458763ca08dbe9c5e35af81481553e336faec6cd3a2501b",
          },
          sttModel: "medium",
          allowedTools: [
            "idea_to_jira_create_draft",
            "idea_to_jira_read_draft",
            "idea_to_jira_patch_draft",
            "idea_to_jira_cancel_draft",
            "idea_to_jira_request_access",
          ],
          limits: {
            inputTextChars: 20000,
            requestsPerMinute: 20,
            burst: 5,
            activeDrafts: 3,
          },
          retention: {
            draftDays: 90,
            auditDays: 365,
          },
          stateDir: "/home/node/.openclaw/plugin-state/idea-to-jira",
        },
      },
    },
  },
  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },
}
