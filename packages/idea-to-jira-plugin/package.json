{
  "name": "@idea-to-jira/openclaw-plugin",
  "version": "0.1.0",
  "description": "OpenClaw plugin scaffold for idea intake, duplicate search and Jira Feature creation.",
  "type": "module",
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ],
  "exports": {
    ".": "./dist/src/index.js"
  },
  "dependencies": {
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "openclaw": "2026.7.1-2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/index.js"
    ],
    "runtimeExtensions": [
      "./dist/src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    },
    "install": {
      "minHostVersion": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "clean": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  }
}
